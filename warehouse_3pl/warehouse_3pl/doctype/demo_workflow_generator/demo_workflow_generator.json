 "fields": [
  {
   "fieldname": "intro_html",
   "fieldtype": "HTML",
   "options": "<div class=\"alert alert-info\"><b>Demo Workflow Generator</b><br>Runs the full 3PL pipeline end-to-end: creates a demo client, items, warehouses and rate card, then drives an ASN through Receiving and Putaway, and a Client Order through Wave, Pick, Pack, and Delivery Note — raising Billing Transactions along the way. Safe to re-run; existing masters are reused.</div>"
  },
  {
   "fieldname": "section_client",
   "fieldtype": "Section Break",
   "label": "Demo Client"
  },
  {
   "fieldname": "client_name",
   "fieldtype": "Data",
   "label": "Client Name",
   "default": "Acme Demo Goods",
   "reqd": 1
  },
  {
   "fieldname": "client_code",
   "fieldtype": "Data",
   "label": "Client Code",
   "default": "ACME-DEMO",
   "reqd": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "description": "Used on auto-generated Stock Entries and Delivery Note. Falls back to the Global Defaults company."
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_temp_zone",
   "fieldtype": "Select",
   "label": "Default Temperature Zone",
   "options": "\nFrozen\nRefrigerated\nCool\nControlled Ambient\nAmbient",
   "default": "Ambient"
  },
  {
   "fieldname": "section_inventory",
   "fieldtype": "Section Break",
   "label": "Inventory"
  },
  {
