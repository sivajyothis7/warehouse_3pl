   "fieldtype": "Float",
   "label": "Receive Qty per Item",
   "default": "50",
   "reqd": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "order_qty",
   "fieldtype": "Float",
   "label": "Order Qty per Item",
   "default": "12",
   "reqd": 1,
   "description": "Must be less than or equal to the received qty per item."
  },
  {
   "fieldname": "section_warehouses",
   "fieldtype": "Section Break",
   "label": "Warehouses"
  },
  {
   "fieldname": "staging_warehouse",
